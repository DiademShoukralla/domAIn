# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001

# Database
DATABASE_URL=postgresql+asyncpg://domain:domain@localhost:5432/domain

# Token encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# API key for service auth (plain text; stored hashed in DB on bootstrap)
BOOTSTRAP_API_KEY=dev-api-key-change-me

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/oauth/github/callback

# Linear OAuth App
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:8000/oauth/linear/callback

# Voyage embeddings
VOYAGE_API_KEY=

# Retrieval
RRF_K=60
RETRIEVAL_TOP_K=10
COVERAGE_MIN_SCORE=0.3
