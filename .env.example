# Application
APP_ENV=development
# Public URL of the domAIn API (used today for post-OAuth redirect targets in oauth routes)
APP_BASE_URL=http://localhost:8000
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001

# Database
DATABASE_URL=postgresql+asyncpg://domain:domain@localhost:5432/domain

# Token encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# API key for service auth (plain text; stored hashed in DB on bootstrap)
BOOTSTRAP_API_KEY=dev-api-key-change-me

# GitHub App (installation flow; Setup URL: https://domain.didi.build/oauth/github/callback)
GITHUB_APP_ID=
# Slug from the app settings URL: https://github.com/apps/<slug>
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Linear OAuth App
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:8000/oauth/linear/callback
# Production example: https://domain.didi.build/oauth/linear/callback

# Voyage embeddings
VOYAGE_API_KEY=
# Optional — only needed if Voyage assigned a specific/regional endpoint; leave blank to use the default
VOYAGE_BASE_URL=

# LLM (Anthropic via LangChain init_chat_model)
ANTHROPIC_API_KEY=
SUPERVISOR_MODEL=anthropic:claude-haiku-4-5
RETRIEVAL_ANSWER_MODEL=anthropic:claude-sonnet-5
COUNCIL_CHAIR_MODEL=anthropic:claude-sonnet-5

# Shared public-ingress Caddy (production deploy only; see .env.production.example)
# INGRESS_SITES_DIR=/path/to/public-ingress/sites
# INGRESS_CADDY_CONTAINER=public-ingress-caddy

# Retrieval
RRF_K=60
RETRIEVAL_TOP_K=10
COVERAGE_MIN_SCORE=0.3
