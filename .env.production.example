# Application
APP_ENV=production
APP_BASE_URL=https://domain.didi.build
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001

# Database (domain-db service; password also used by docker-compose.prod.yml)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://domain:change-me@domain-db:5432/domain

# Container registry (image: ghcr.io/${GHCR_OWNER}/domain:${IMAGE_TAG})
GHCR_OWNER=diademshoukralla

# Shared public-ingress Caddy (see public-ingress repo README)
INGRESS_SITES_DIR=/path/to/public-ingress/sites
INGRESS_CADDY_CONTAINER=public-ingress-caddy

# Token encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# API key for service auth (plain text; stored hashed in DB on bootstrap)
BOOTSTRAP_API_KEY=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Production: https://domain.didi.build/oauth/github/callback
GITHUB_REDIRECT_URI=https://domain.didi.build/oauth/github/callback

# Linear OAuth App
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Production: https://domain.didi.build/oauth/linear/callback
LINEAR_REDIRECT_URI=https://domain.didi.build/oauth/linear/callback

# Voyage embeddings
VOYAGE_API_KEY=
# Optional — only needed if Voyage assigned a specific/regional endpoint; leave blank to use the default
VOYAGE_BASE_URL=

# LLM (Anthropic via LangChain init_chat_model)
ANTHROPIC_API_KEY=
SUPERVISOR_MODEL=anthropic:claude-haiku-4-5
RETRIEVAL_ANSWER_MODEL=anthropic:claude-sonnet-4-20250514
COUNCIL_CHAIR_MODEL=anthropic:claude-sonnet-4-20250514

# Retrieval
RRF_K=60
RETRIEVAL_TOP_K=10
COVERAGE_MIN_SCORE=0.3
